services:
  # 1. Base de données PostgreSQL
  db:
    image: postgres:latest
    container_name: medpredict_db
    environment:
      POSTGRES_DB: medpredict_db
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: password123
    volumes:
      - postgres_data:/var/lib/postgresql
    ports:
      - "5432:5432"

  # 2. Backend Django
  backend:
    build: ./backend
    container_name: medpredict_backend
    volumes:
      - ./backend:/app
    ports:
      - "8000:8000"
    env_file:
      - .env 
    environment:
      - DATABASE_NAME=medpredict_db
      - DATABASE_USER=admin
      - DATABASE_PASSWORD=password123
      - DATABASE_HOST=db
    depends_on:
      - db
    command: python manage.py runserver 0.0.0.0:8000

  redis:
    image: redis:7-alpine
    ports: ["6379:6379"]

  celery:
    build: ./backend
    env_file:
      - .env 
    command: celery -A config worker -l info
    dns:
      - 8.8.8.8
      - 8.8.4.4
    depends_on: [backend, redis]
    environment:
      - DJANGO_SETTINGS_MODULE=config.settings
  # 3. Frontend React (Vite) - AJOUTÉ
